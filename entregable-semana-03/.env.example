# Copia este archivo como .env y rellena los valores.
# El .env se carga automaticamente desde src/config.py (python-dotenv).

# API publica de SwingTails (Render). Cambia a http://localhost:3001 para local.
SWINGTAILS_API_BASE=https://swingtails-api-yz02.onrender.com

# Opcion A: define usuario/contrasena y el agente hara login automatico al arrancar.
# El agente actua EN NOMBRE de este usuario: su user_id (extraido del JWT) se
# usa para registrar mascotas, agendar citas y el carrito. En el REPL tambien
# puedes escribir 'login' para entrar con otra cuenta.
# NOTA: la contrasena debe tener mayuscula + minuscula + numero + simbolo
#       (p.ej. Password123!). "password123" es rechazada por la API.
SWINGTAILS_EMAIL=
SWINGTAILS_PASSWORD=

# Opcion B: si ya tienes un JWT, pegalo aqui y se usara directamente
# (tiene prioridad sobre email/password).
SWINGTAILS_JWT=

# Ollama local
OLLAMA_HOST=http://localhost:11434
